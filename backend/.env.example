# Copia este archivo como .env y completa los valores de tu proyecto de Supabase.
# Nunca subas el archivo .env al repositorio.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
PORT=3001

# Orígenes que pueden llamar a la API desde el navegador, separados por coma.
CORS_ORIGINS=http://localhost:5173
# Intentos de voto permitidos por IP cada 15 minutos.
VOTE_RATE_LIMIT=5
# Número de proxies delante del servidor (por ejemplo 1 detrás de Nginx o Render). Déjalo vacío en local.
TRUST_PROXY=
